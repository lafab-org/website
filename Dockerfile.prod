FROM node:lts-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
RUN --mount=type=cache,target=/app/_site/img \
    --mount=type=cache,target=/app/.cache \
    npm run build

FROM nginx:stable-alpine

COPY --from=builder /app/_site /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
