<header class="b_site-header">
  <div class="l_repel l_box l_center" style="--l_center__size: min(90%, 1100px)">
    <a href="/" class="b_site-header__logo u_text-decoration-none">{{ site.name }}</a>
    <nav class="l_cluster" style="--l_cluster__gap: 2rem">
      {% for item in navigation %}
        <a href="{{ item.url }}">{{ item.label }}</a>
      {% endfor %}
    </nav>
  </div>
</header>
